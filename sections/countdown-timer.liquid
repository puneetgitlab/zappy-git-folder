
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %} countdown-timer-section"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="countdown-timer-card" id="countdown-{{ section.id }}">
    <span class="countdown-timer__eyebrow">
      {{ section.settings.eyebrow | default: 'Limited time' }}
    </span>

    <h2 class="countdown-timer__heading">
      {{ section.settings.heading | default: 'Hurry! Offer ends in' }}
    </h2>

    <p class="countdown-timer__subheading">
      {{ section.settings.subheading | default: "Don't miss out — grab the deal before the timer runs out." }}
    </p>

    <div
      class="countdown-timer"
      data-countdown-duration="{{ section.settings.duration_minutes | times: 60 | default: 3600 }}"
    >
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value" data-countdown-hours>00</span>
        </div>
        <span class="countdown-timer__label">Hours</span>
      </div>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value" data-countdown-minutes>00</span>
        </div>
        <span class="countdown-timer__label">Minutes</span>
      </div>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value countdown-timer__value--pulse" data-countdown-seconds>00</span>
        </div>
        <span class="countdown-timer__label">Seconds</span>
      </div>
    </div>

    <a
      class="countdown-timer__button"
      href="{{ section.settings.button_link | default: '/collections/all' }}"
    >
      {{ section.settings.button_label | default: 'Shop now' }}
    </a>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById('countdown-{{ section.id }}');
    if (!root) return;
    const timerEl = root.querySelector('.countdown-timer');
    if (!timerEl) return;

    const duration = parseInt(timerEl.dataset.countdownDuration, 10) || 3600;
    const endTime = Date.now() + duration * 1000;

    const hoursEl = timerEl.querySelector('[data-countdown-hours]');
    const minutesEl = timerEl.querySelector('[data-countdown-minutes]');
    const secondsEl = timerEl.querySelector('[data-countdown-seconds]');

    const pad = (n) => (n < 10 ? '0' + n : '' + n);

    function update(el, val) {
      const padded = pad(val);
      if (el.textContent !== padded) {
        el.textContent = padded;
        el.classList.remove('is-tick');
        // Force reflow to restart animation
        void el.offsetWidth;
        el.classList.add('is-tick');
      }
    }

    function tick() {
      const remaining = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
      update(hoursEl, Math.floor(remaining / 3600));
      update(minutesEl, Math.floor((remaining % 3600) / 60));
      update(secondsEl, remaining % 60);
      if (remaining <= 0) {
        clearInterval(timer);
        root.classList.add('is-expired');
      }
    }

    tick();
    const timer = setInterval(tick, 1000);
  })();
</script>

{% stylesheet %}
  .countdown-timer-section {
    display: flex;
    justify-content: center;
  }

  .countdown-timer-card {
    width: 100%;
    max-width: 720px;
    padding: 48px 32px;
    border-radius: 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.08), transparent 60%),
      radial-gradient(circle at 80% 100%, rgba(255, 255, 255, 0.06), transparent 60%),
      linear-gradient(135deg, #0f0f12 0%, #1a1a23 50%, #2a1f3d 100%);
    color: #fff;
    box-shadow:
      0 24px 60px -20px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }

  .countdown-timer-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 26px;
    padding: 2px;
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.45), rgba(236, 72, 153, 0.0) 40%, rgba(59, 130, 246, 0.35));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .countdown-timer__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 16px;
    color: #f5f5f7;
  }

  .countdown-timer__heading {
    margin: 0 0 8px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    background: linear-gradient(180deg, #ffffff 0%, #c9c9d4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .countdown-timer__subheading {
    margin: 0 0 32px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .countdown-timer {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .countdown-timer__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .countdown-timer__tile {
    position: relative;
    min-width: 88px;
    padding: 18px 16px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 6px 16px -8px rgba(0, 0, 0, 0.6),
      0 1px 0 0 rgba(255, 255, 255, 0.08) inset;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
  }

  .countdown-timer__tile::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    pointer-events: none;
  }

  .countdown-timer__value {
    display: block;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 12px rgba(168, 85, 247, 0.25);
  }

  .countdown-timer__value.is-tick {
    animation: countdown-tick 0.45s ease-out;
  }

  @keyframes countdown-tick {
    0% {
      transform: translateY(-6px);
      opacity: 0;
      filter: blur(2px);
    }
    100% {
      transform: translateY(0);
      opacity: 1;
      filter: blur(0);
    }
  }

  .countdown-timer__label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.55);
  }

  .countdown-timer__separator {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
    align-self: flex-start;
    padding-top: 18px;
  }

  .countdown-timer__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: #0f0f12;
    background: linear-gradient(135deg, #ffffff 0%, #e9e9f0 100%);
    box-shadow:
      0 8px 22px -10px rgba(255, 255, 255, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.18) inset;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .countdown-timer__button:hover {
    transform: translateY(-1px);
    box-shadow:
      0 14px 30px -10px rgba(255, 255, 255, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.28) inset;
    text-decoration: none;
  }

  .countdown-timer-card.is-expired .countdown-timer__tile {
    opacity: 0.6;
  }

  @media screen and (max-width: 540px) {
    .countdown-timer-card {
      padding: 36px 20px;
      border-radius: 20px;
    }

    .countdown-timer {
      gap: 8px;
    }

    .countdown-timer__tile {
      min-width: 64px;
      padding: 14px 10px;
      border-radius: 12px;
    }

    .countdown-timer__separator {
      padding-top: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hurry! Offer ends in"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't miss out — grab the deal before the timer runs out."
    },
    {
      "type": "number",
      "id": "duration_minutes",
      "label": "Duration (minutes)",
      "default": 60,
      "info": "How many minutes the timer counts down from page load."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Countdown timer",
      "category": "t:categories.layout",
      "settings": {
        "duration_minutes": 60
      }
    }
  ]
}
{% endschema %}
