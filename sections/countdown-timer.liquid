

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} countdown-timer-section"
  style="padding-block-start: {{ section.settings.padding-block-start }}px; padding-block-end: {{ section.settings.padding-block-end }}px;"
>
  <div
    class="countdown-timer-card"
    data-countdown-id="countdown-{{ section.id }}"
    data-countdown-duration="{{ section.settings.duration_minutes | times: 60 }}"
  >
    <span class="countdown-timer__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="countdown-timer__heading">{{ section.settings.heading }}</h2>
    <p class="countdown-timer__subheading">{{ section.settings.subheading }}</p>

    <div class="countdown-timer">
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value" data-countdown-hours>00</span>
        </div>
        <span class="countdown-timer__label">Hours</span>
      </div>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value" data-countdown-minutes>00</span>
        </div>
        <span class="countdown-timer__label">Minutes</span>
      </div>
      <span class="countdown-timer__separator" aria-hidden="true">:</span>
      <div class="countdown-timer__unit">
        <div class="countdown-timer__tile">
          <span class="countdown-timer__value" data-countdown-seconds>00</span>
        </div>
        <span class="countdown-timer__label">Seconds</span>
      </div>
    </div>

    <a class="countdown-timer__button" href="{{ section.settings.button_link }}">
      {{ section.settings.button_label }}
    </a>
  </div>
</div>

{% javascript %}
  document.querySelectorAll('.countdown-timer-card').forEach(function (card) {
    if (card.dataset.countdownInit === '1') return;
    card.dataset.countdownInit = '1';

    var duration = parseInt(card.dataset.countdownDuration, 10) || 3600;
    var endTime = Date.now() + duration * 1000;

    var hoursEl = card.querySelector('[data-countdown-hours]');
    var minutesEl = card.querySelector('[data-countdown-minutes]');
    var secondsEl = card.querySelector('[data-countdown-seconds]');

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var remaining = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
      hoursEl.textContent = pad(Math.floor(remaining / 3600));
      minutesEl.textContent = pad(Math.floor((remaining % 3600) / 60));
      secondsEl.textContent = pad(remaining % 60);
      if (remaining <= 0) {
        clearInterval(timer);
        card.classList.add('is-expired');
      }
    }

    tick();
    var timer = setInterval(tick, 1000);
  });
{% endjavascript %}

{% stylesheet %}
  .countdown-timer-section {
    display: flex;
    justify-content: center;
  }

  .countdown-timer-card {
    width: 100%;
    max-width: 720px;
    padding: 48px 32px;
    border-radius: 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.08), transparent 60%),
      radial-gradient(circle at 80% 100%, rgba(255, 255, 255, 0.06), transparent 60%),
      linear-gradient(135deg, #0f0f12 0%, #1a1a23 50%, #2a1f3d 100%);
    color: #fff;
    box-shadow:
      0 24px 60px -20px rgba(0, 0, 0, 0.45),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .countdown-timer__eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 16px;
    color: #f5f5f7;
  }

  .countdown-timer__heading {
    margin: 0 0 8px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  .countdown-timer__subheading {
    margin: 0 0 32px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .countdown-timer {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .countdown-timer__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .countdown-timer__tile {
    position: relative;
    min-width: 88px;
    padding: 18px 16px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 6px 16px -8px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .countdown-timer__value {
    display: block;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-shadow: 0 2px 12px rgba(168, 85, 247, 0.25);
  }

  .countdown-timer__label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.55);
  }

  .countdown-timer__separator {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: rgba(255, 255, 255, 0.35);
    align-self: flex-start;
    padding-top: 18px;
  }

  .countdown-timer__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 32px;
    padding: 14px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: #0f0f12;
    background: linear-gradient(135deg, #ffffff 0%, #e9e9f0 100%);
    box-shadow:
      0 8px 22px -10px rgba(255, 255, 255, 0.5),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .countdown-timer__button:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .countdown-timer-card.is-expired .countdown-timer__tile {
    opacity: 0.6;
  }

  @media screen and (max-width: 540px) {
    .countdown-timer-card {
      padding: 36px 20px;
      border-radius: 20px;
    }

    .countdown-timer__tile {
      min-width: 64px;
      padding: 14px 10px;
      border-radius: 12px;
    }

    .countdown-timer__separator {
      padding-top: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hurry! Offer ends in"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't miss out before the timer runs out."
    },
    {
      "type": "range",
      "id": "duration_minutes",
      "label": "Duration (minutes)",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "min",
      "default": 60
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Countdown timer",
      "category": "Layout"
    }
  ]
}
{% endschema %}
