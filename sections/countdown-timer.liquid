
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style {% if section.settings.color_scheme != blank %}color-{{ section.settings.color_scheme }}{% endif %} countdown-timer-section"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="countdown-timer__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div
    class="countdown-timer"
    data-countdown-duration="{{ section.settings.duration_minutes | times: 60 | default: 3600 }}"
  >
    <div class="countdown-timer__unit">
      <span class="countdown-timer__value" data-countdown-hours>00</span>
      <span class="countdown-timer__label">Hours</span>
    </div>
    <div class="countdown-timer__separator">:</div>
    <div class="countdown-timer__unit">
      <span class="countdown-timer__value" data-countdown-minutes>00</span>
      <span class="countdown-timer__label">Minutes</span>
    </div>
    <div class="countdown-timer__separator">:</div>
    <div class="countdown-timer__unit">
      <span class="countdown-timer__value" data-countdown-seconds>00</span>
      <span class="countdown-timer__label">Seconds</span>
    </div>
  </div>
</div>

<script>
  (function () {
    const root = document.currentScript.previousElementSibling.querySelector('.countdown-timer');
    if (!root) return;

    const duration = parseInt(root.dataset.countdownDuration, 10) || 3600;
    const endTime = Date.now() + duration * 1000;

    const hoursEl = root.querySelector('[data-countdown-hours]');
    const minutesEl = root.querySelector('[data-countdown-minutes]');
    const secondsEl = root.querySelector('[data-countdown-seconds]');

    function pad(n) {
      return n < 10 ? '0' + n : '' + n;
    }

    function tick() {
      const remaining = Math.max(0, Math.floor((endTime - Date.now()) / 1000));
      hoursEl.textContent = pad(Math.floor(remaining / 3600));
      minutesEl.textContent = pad(Math.floor((remaining % 3600) / 60));
      secondsEl.textContent = pad(remaining % 60);
      if (remaining <= 0) clearInterval(timer);
    }

    tick();
    const timer = setInterval(tick, 1000);
  })();
</script>

{% stylesheet %}
  .countdown-timer-section {
    text-align: center;
  }

  .countdown-timer__heading {
    margin: 0 0 16px;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .countdown-timer {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }

  .countdown-timer__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 64px;
  }

  .countdown-timer__value {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .countdown-timer__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
    opacity: 0.7;
  }

  .countdown-timer__separator {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    padding-bottom: 18px;
    opacity: 0.5;
  }

  @media screen and (max-width: 480px) {
    .countdown-timer__value,
    .countdown-timer__separator {
      font-size: 1.75rem;
    }

    .countdown-timer__unit {
      min-width: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hurry! Offer ends in"
    },
    {
      "type": "range",
      "id": "duration_minutes",
      "label": "Duration (minutes)",
      "min": 1,
      "max": 1440,
      "step": 1,
      "unit": "min",
      "default": 60
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Countdown timer",
      "category": "t:categories.layout",
      "settings": {
        "duration_minutes": 60
      }
    }
  ]
}
{% endschema %}
